# GEMINI_API_KEY: Required for Gemini AI API calls (OCR, embeddings, translations).
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (used for OAuth callbacks).
APP_URL="https://your-domain.example.com"

# Google Drive OAuth2 credentials (for backup/restore — optional)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# DATABASE_PATH: Where the SQLite database is stored (for persistent volumes).
# Defaults to ./knowledge.db if not set.
DATABASE_PATH="/app/data/knowledge.db"
